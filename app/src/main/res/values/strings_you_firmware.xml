<?xml version="1.0" encoding="utf-8"?>
<!--
  The strap's firmware and the Zepp account its update check signs in with, pages opened from the Strap page, and the
  Zepp sign-in (ui/firmware/, ui/zepp/ZeppSignIn.kt, ui/device/ErrorCopy.kt). unstrap is the app's name, written in lowercase even at the start of a sentence, Zepp is the
  strap maker's app, account and servers, Amazfit Helio Strap is the strap
  and Google, Apple, Facebook and Xiaomi are sign-in providers. Keep them as they are.
-->
<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The Firmware page's title, and the label beside the strap's version. -->
    <string name="you_firmware_title">Firmware</string>
    <!-- The panel about the strap. -->
    <string name="you_firmware_this_strap">This strap</string>
    <string name="you_firmware_unknown">Unknown</string>
    <string name="you_firmware_hardware">Hardware</string>
    <string name="you_firmware_battery">Battery</string>
    <!-- A percentage, the battery or how far an install has gone. -->
    <string name="you_firmware_percent"><xliff:g id="percent" example="86">%1$d</xliff:g>%%</string>
    <string name="you_firmware_not_connected">Not connected</string>
    <!-- Whether the strap offers its firmware update service. -->
    <string name="you_firmware_service">Update service</string>
    <string name="you_firmware_service_available">Available</string>
    <string name="you_firmware_service_not_found">Not found</string>
    <string name="you_firmware_service_unknown">Connect to check</string>
    <!-- A row that opens a firmware file from the phone. -->
    <string name="you_firmware_from_file">Install from a file</string>
    <string name="you_firmware_from_file_note">For an image you have</string>
    <!-- The privacy panel: its title, then three points, a short title and one sentence each. -->
    <string name="you_firmware_privacy">Privacy and safety</string>
    <string name="you_firmware_privacy_sign_in">Sign-in</string>
    <string name="you_firmware_privacy_sign_in_text">Happens on Zepp\'s own page. unstrap keeps only the app token and user ID, and fetches your device list once.</string>
    <string name="you_firmware_privacy_check">Update check</string>
    <string name="you_firmware_privacy_check_text">Sends the update server your token, user ID and the strap\'s firmware, hardware and serial number. Nothing else.</string>
    <string name="you_firmware_privacy_install">Safe install</string>
    <string name="you_firmware_privacy_install_text">Downloads are checked against the server\'s checksum, and the strap verifies the signature before installing.</string>

    <!-- The update panel before a check: its title, what it does and the button. -->
    <string name="you_firmware_updates">Updates</string>
    <string name="you_firmware_updates_text">Ask Zepp\'s update server whether there\'s newer firmware for this strap.</string>
    <string name="you_firmware_check">Check for updates</string>
    <string name="you_firmware_checking">Checking for updates…</string>
    <!-- While a part downloads: its name and version, "Firmware 3.25.1". -->
    <string name="you_firmware_downloading">Downloading <xliff:g id="part" example="Firmware">%1$s</xliff:g> <xliff:g id="version" example="3.25.1">%2$s</xliff:g>…</string>
    <!-- A downloaded part's title: its name and version. -->
    <string name="you_firmware_part_title"><xliff:g id="part" example="Firmware">%1$s</xliff:g> <xliff:g id="version" example="3.25.1">%2$s</xliff:g></string>
    <string name="you_firmware_ready">Ready to install</string>
    <!-- Labels beside the image's details. -->
    <string name="you_firmware_image">Image</string>
    <string name="you_firmware_size">Size</string>
    <!-- The image's size in megabytes, one decimal. -->
    <string name="you_firmware_megabytes"><xliff:g id="megabytes" example="1.2">%1$.1f</xliff:g> MB</string>
    <string name="you_firmware_signed_for">Signed for</string>
    <!-- The product the image is signed for, and its version, "product 157 v1". -->
    <string name="you_firmware_signed_for_value">product <xliff:g id="product" example="157">%1$d</xliff:g> v<xliff:g id="version" example="1">%2$d</xliff:g></string>
    <string name="you_firmware_install">Install</string>
    <string name="you_firmware_installing_note">Keep the strap close and this screen open. This can take several minutes.</string>
    <string name="you_firmware_installed">Installed</string>
    <string name="you_firmware_installed_text">The strap is restarting. unstrap reconnects by itself. Check again afterwards in case there are more parts to install.</string>
    <string name="you_firmware_done">Done</string>
    <string name="you_firmware_failed">Something went wrong</string>
    <string name="you_firmware_ok">OK</string>
    <string name="you_firmware_up_to_date">Up to date</string>
    <string name="you_firmware_up_to_date_text">The update server has nothing newer for this strap.</string>
    <string name="you_firmware_required">Required update</string>
    <string name="you_firmware_available">Update available</string>
    <!-- A part's version and download size, "3.25.1, 1,204 KB". The size is already formatted. -->
    <string name="you_firmware_part_size"><xliff:g id="version" example="3.25.1">%1$s</xliff:g>, <xliff:g id="size" example="1,204">%2$s</xliff:g> KB</string>
    <string name="you_firmware_parts_note">Parts are installed one at a time. After the strap restarts, check again to install the next one.</string>
    <string name="you_firmware_not_now">Not now</string>
    <!-- The download button when no part can be installed by unstrap. -->
    <string name="you_firmware_unsupported">Can\'t install</string>
    <string name="you_firmware_download">Download</string>
    <!-- Asked before installing. The title is the image's, "Firmware 3.25.1". -->
    <string name="you_firmware_confirm_title">Install <xliff:g id="title" example="Firmware 3.25.1">%1$s</xliff:g>?</string>
    <string name="you_firmware_confirm_text">The strap will receive the image, check it, install it and restart. Keep it near the phone and don\'t close unstrap until it\'s done.</string>
    <!-- A switch under the warnings, which allows the install. -->
    <string name="you_firmware_confirm_anyway">I understand and want to install it anyway</string>

    <!-- Why a check, download or install can't start, or went wrong. -->
    <string name="you_firmware_no_account">Sign in to Zepp first.</string>
    <string name="you_firmware_no_version">Connect the strap first so its firmware version is known.</string>
    <string name="you_firmware_check_failed">Update check failed</string>
    <!-- A part of a kind unstrap doesn't know, by its code. -->
    <string name="you_firmware_unknown_part">unstrap can\'t install this kind of part (<xliff:g id="code" example="xyz">%1$s</xliff:g>)</string>
    <string name="you_firmware_download_failed">Download failed</string>
    <string name="you_firmware_install_failed">Install failed</string>
    <plurals name="you_firmware_file_size">
        <item quantity="one">That file is <xliff:g id="bytes" example="512">%1$d</xliff:g> byte, which isn\'t a plausible firmware image.</item>
        <item quantity="other">That file is <xliff:g id="bytes" example="512">%1$d</xliff:g> bytes, which isn\'t a plausible firmware image.</item>
    </plurals>
    <!-- Warnings to read before installing a file. -->
    <string name="you_firmware_file_untrusted">This file didn\'t come from Zepp\'s update server for this strap. Only install files you trust.</string>
    <string name="you_firmware_file_unsigned">This file has no firmware signature. It\'s probably not firmware for this strap.</string>
    <!-- The title of an image from a file. -->
    <string name="you_firmware_file_title">Firmware from file</string>
    <string name="you_firmware_file_unread">Couldn\'t read the file. Choose it again.</string>
    <string name="you_firmware_wrong_product">The image says it\'s for product <xliff:g id="image" example="158">%1$d</xliff:g>, but this strap is product <xliff:g id="strap" example="157">%2$d</xliff:g>.</string>
    <plurals name="you_firmware_wrong_size">
        <item quantity="one">The file is shorter than the image says (<xliff:g id="size" example="1234567">%1$d</xliff:g> byte). It may be incomplete.</item>
        <item quantity="other">The file is shorter than the image says (<xliff:g id="size" example="1234567">%1$d</xliff:g> bytes). It may be incomplete.</item>
    </plurals>
    <!-- What must be done before installing. -->
    <string name="you_firmware_block_connect">Connect the strap.</string>
    <string name="you_firmware_block_battery_unknown">Battery level unknown. Reconnect the strap.</string>
    <string name="you_firmware_block_battery">Charge the strap above <xliff:g id="min" example="30">%1$d</xliff:g>%% (now <xliff:g id="battery" example="20">%2$d</xliff:g>%%).</string>
    <!-- Install steps, one line each. -->
    <string name="you_firmware_step_starting">Starting…</string>
    <string name="you_firmware_step_sending">Sending to strap…</string>
    <string name="you_firmware_step_validating">Strap is checking the image…</string>
    <string name="you_firmware_step_applying">Strap is installing…</string>
    <string name="you_firmware_step_restarting">Restarting…</string>

    <!-- Why the update server or Zepp failed. -->
    <string name="you_error_firmware_rejected">Zepp\'s update server didn\'t accept the sign-in. It may have expired. Sign in again.</string>
    <string name="you_error_firmware_server">Zepp\'s update server didn\'t answer as expected. Try again in a few minutes.</string>
    <string name="you_error_firmware_download">The firmware download failed. Try again in a few minutes.</string>
    <string name="you_error_firmware_damaged">The firmware download was damaged. Try again.</string>
    <string name="you_error_firmware_network">Couldn\'t reach the update server. Check your internet connection and try again.</string>
    <string name="you_error_zepp_rejected">Zepp didn\'t accept the sign-in. It may have expired, or the account is in another region. Sign in again.</string>
    <string name="you_error_zepp_server">Zepp didn\'t answer as expected. It may be having trouble. Try again in a few minutes.</string>
    <string name="you_error_zepp_network">Couldn\'t reach Zepp\'s servers. Check your internet connection and try again.</string>

    <!-- The Zepp account page's title. -->
    <string name="you_zepp_title">Zepp account</string>
    <!-- The sign-in's confirm button from the Zepp account page. -->
    <string name="you_zepp_save_sign_in">Save sign-in</string>
    <string name="you_zepp_account_none">Zepp only answers update checks for signed-in users. Sign in, or paste your own app token and user ID. They\'re stored on this phone only.</string>
    <!-- The server is an address, "https://api-mifit-us2.zepp.com". -->
    <string name="you_zepp_account_user">Update checks use your saved token for user <xliff:g id="user" example="1234567890">%1$s</xliff:g> on <xliff:g id="server" example="https://api-mifit-us2.zepp.com">%2$s</xliff:g>.</string>
    <string name="you_zepp_account">Update checks use your saved token on <xliff:g id="server" example="https://api-mifit-us2.zepp.com">%1$s</xliff:g>.</string>
    <string name="you_zepp_sign_in_again">Sign in again</string>
    <string name="you_zepp_paste_token">Paste token</string>
    <string name="you_zepp_edit">Edit</string>
    <string name="you_zepp_remove">Remove</string>
    <!-- Field labels. -->
    <string name="you_zepp_app_token">App token</string>
    <string name="you_zepp_keep_token">Leave empty to keep the saved token</string>
    <string name="you_zepp_user_id">User ID</string>
    <string name="you_zepp_server">Server</string>
    <string name="you_zepp_china">Chinese-market strap</string>
    <string name="you_zepp_china_note">Only if the strap was bought in mainland China</string>

    <!-- The Zepp sign-in page: its close button for screen readers, its title and a button that starts over. -->
    <string name="you_zepp_close">Close</string>
    <string name="you_zepp_sign_in_title">Sign in with Zepp</string>
    <string name="you_zepp_reset">Reset</string>
    <string name="you_zepp_sign_in_text">Use the email and password of the Zepp account your strap is linked to. Google, Apple, Facebook and Xiaomi sign-in don\'t work here.</string>
    <string name="you_zepp_sign_in_note">This is Zepp\'s own page, so unstrap never sees your password. It reads only the app token and user ID, then asks Zepp once for your devices.</string>
    <!-- The provider is a sign-in the user picked, "Google" or "Apple", named twice. "sign-in in" is meant, not a typo. -->
    <string name="you_zepp_third_party" tools:ignore="Typos"><xliff:g id="provider" example="Google">%1$s</xliff:g> sign-in doesn\'t work inside unstrap, because <xliff:g id="provider" example="Google">%1$s</xliff:g> blocks sign-in in embedded pages.\n\nOpen the Zepp app and add an email and password to your account in its account settings. Then sign in here with that email. Or get the auth key on a computer.</string>
    <string name="you_zepp_fetching">Signed in. Looking up your devices…</string>
    <string name="you_zepp_use_email">Use email sign-in</string>
    <string name="you_zepp_no_devices">Couldn\'t get your devices</string>
    <string name="you_zepp_sign_in_email">Sign in with email</string>
    <string name="you_zepp_found">Found your Helio Strap</string>
    <string name="you_zepp_not_found">No Helio Strap on this account</string>
    <string name="you_zepp_account_empty">This account has no devices. Link the strap in the Zepp app first. If it\'s already linked, sign in with the email of the account the Zepp app uses.</string>
    <plurals name="you_zepp_account_other_devices">
        <item quantity="one">This account has <xliff:g id="count" example="2">%1$d</xliff:g> device, but it isn\'t an Amazfit Helio Strap. Link the strap in the Zepp app, then sign in again.</item>
        <item quantity="other">This account has <xliff:g id="count" example="2">%1$d</xliff:g> devices, but none is an Amazfit Helio Strap. Link the strap in the Zepp app, then sign in again.</item>
    </plurals>
    <string name="you_zepp_key_missing">Not on the account</string>
    <!-- Labels beside the found strap's details. -->
    <string name="you_zepp_serial">Serial</string>
    <string name="you_zepp_region">Region</string>
    <string name="you_zepp_region_china">China</string>
    <string name="you_zepp_region_global">Global</string>
    <string name="you_zepp_no_key">Zepp didn\'t return an auth key for this strap. Check in the Zepp app that the strap is still linked, then sign in here again.</string>
    <string name="you_zepp_user">Zepp user</string>
    <string name="you_zepp_keep_on_charger">Keep the strap on its charger near the phone. Don\'t unlink it in the Zepp app: that wipes this key from the strap.</string>
    <string name="you_zepp_token_stays">The app token and user ID stay on this phone only, for firmware checks.</string>
    <string name="you_zepp_keep_sign_in">Save sign-in only</string>
    <string name="you_zepp_other_account">Use another account</string>
    <!-- A two line button that opens a guide in the browser: the question, then what it does. -->
    <string name="you_zepp_guide">Can\'t sign in with email?</string>
    <string name="you_zepp_guide_note">Get the key on a computer</string>
</resources>
