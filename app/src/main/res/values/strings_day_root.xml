<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's frame (ui/root and ui/components): the tab bar, pull to sync, and the messages and dialogs when Android
  permissions or Health Connect are missing. unstrap, Health Connect and Nearby devices (Android's name for the
  Bluetooth permission) are names, keep them as Android shows them in the phone's language.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The tab bar's tabs, one word each under an icon. Also the title of the Recovery and Sleep pages opened from a card. -->
    <string name="day_tab_today">Today</string>
    <string name="day_tab_recovery">Recovery</string>
    <string name="day_tab_sleep">Sleep</string>
    <string name="day_tab_activity">Activity</string>

    <!-- A message when Health Connect isn't on the phone and can't be installed. -->
    <string name="day_hc_unavailable">Health Connect isn\'t available on this phone.</string>
    <!-- A message when Health Connect can be installed from the Play Store. -->
    <string name="day_hc_install_first">Install Health Connect first.</string>
    <!-- A message when the user turned Health Connect's permissions down. -->
    <string name="day_hc_not_granted">unstrap doesn\'t have Health Connect permission.</string>

    <!-- A message when the user turned the Bluetooth permission down. -->
    <string name="day_bluetooth_required">unstrap needs Nearby devices to reach your strap.</string>
    <!-- The same on Android 11, where finding the strap needs the location permission instead. -->
    <string name="day_bluetooth_required_location">unstrap needs location access to find your strap. It doesn\'t use your location.</string>
    <!-- A message when the user turned location down for a workout: it starts anyway, without GPS. -->
    <string name="day_location_declined">Without location, distance comes from the strap\'s steps.</string>
    <!-- The dialog when Nearby devices was turned down for good: its title. -->
    <string name="day_nearby_title">Allow Nearby devices</string>
    <!-- Its text. Permissions is the heading in Android's settings page for the app. -->
    <string name="day_nearby_text">unstrap needs Nearby devices to find and connect to your strap. Android won\'t ask again, so turn it on in unstrap\'s settings, under Permissions.</string>
    <!-- The same dialog on Android 11, where finding the strap needs the location permission instead. -->
    <string name="day_nearby_title_location">Allow location</string>
    <string name="day_nearby_text_location">On Android 11, unstrap needs location access to find and connect to your strap. It doesn\'t use your location. Android won\'t ask again, so turn it on in unstrap\'s settings, under Permissions.</string>
    <!-- Its button that opens Android's settings page for the app. -->
    <string name="day_nearby_open_settings">Open settings</string>
    <!-- Its button that closes it. -->
    <string name="day_nearby_not_now">Not now</string>

    <!-- A message after a pull to sync failed, then "Your data is still on the strap." -->
    <string name="day_pull_sync_failed">Couldn\'t sync. <xliff:g id="data_on_strap" example="Your data is still on the strap.">%1$s</xliff:g></string>
    <!-- A message when pulling to sync while the strap isn't connected. -->
    <string name="day_pull_not_connected">The strap isn\'t connected.</string>
    <!-- Under the header while pulling down: the line while a sync runs. One line. -->
    <string name="day_pull_syncing">Syncing strap…</string>
    <!-- The same once the pull is far enough. -->
    <string name="day_pull_release">Release to sync strap</string>
    <!-- The same while pulling. -->
    <string name="day_pull_pull">Pull to sync strap</string>
</resources>
