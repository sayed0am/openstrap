<?xml version="1.0" encoding="utf-8"?>
<!--
  Updates: the You page's Updates row, the Updates page and the update notifications (update/UpdateCopy.kt).
  OpenStrap is the app's name and GitHub is where its releases are. Keep both as they are.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The You page's Updates row, under its title, when a newer version can be installed. One line. -->
    <string name="update_summary_ready">OpenStrap <xliff:g id="version" example="2.2.0">%1$s</xliff:g> is ready to install</string>
    <!-- The You page's Updates row while it asks GitHub for new versions. -->
    <string name="update_summary_checking">Checking</string>
    <!-- The You page's Updates row before it has ever checked: the version running. -->
    <string name="update_summary_version">Version <xliff:g id="version" example="2.1.0">%1$s</xliff:g></string>
    <!-- The You page's Updates row when no newer version is out. The time is "today at 19:00", "yesterday at 23:50" or a date. -->
    <string name="update_summary_up_to_date">Up to date. Checked <xliff:g id="when" example="today at 19:00">%1$s</xliff:g></string>

    <!-- The Updates page's Check now row, under its title, while it asks GitHub. -->
    <string name="update_check_checking">Checking GitHub</string>
    <!-- The Check now row when the last check failed. The time is "today at 19:00", "yesterday at 23:50" or a date. -->
    <string name="update_check_failed_last">Couldn\'t reach GitHub. Last checked <xliff:g id="when" example="today at 19:00">%1$s</xliff:g></string>
    <!-- The Check now row when the only check failed. -->
    <string name="update_check_failed">Couldn\'t reach GitHub</string>
    <!-- The Check now row. The time is "today at 19:00", "yesterday at 23:50" or a date. -->
    <string name="update_check_last">Last checked <xliff:g id="when" example="today at 19:00">%1$s</xliff:g></string>
    <!-- The Check now row before the first check. -->
    <string name="update_check_never">Never checked</string>

    <!-- The install row, under the version, while the new version downloads and its size is known. -->
    <string name="update_install_downloading_percent">Downloading, <xliff:g id="percent" example="45">%1$d</xliff:g>%%</string>
    <!-- The install row while the new version downloads and its size isn't known: how much has come so far. -->
    <string name="update_install_downloading_size">Downloading, <xliff:g id="size" example="19.3 MB">%1$s</xliff:g></string>
    <!-- The install row once Android has the new version. OpenStrap closes itself to update. -->
    <string name="update_install_installing">Installing. OpenStrap closes when it\'s done</string>
    <!-- The install row when the release on GitHub has no app file (APK) to install. -->
    <string name="update_install_no_apk">No APK in this release. Open it on GitHub</string>
    <!-- The install row while a workout records, and why an install waited for one: installing closes the app. -->
    <string name="update_install_after_workout">After your workout. Installing closes the app</string>
    <!-- The install row, a tap to start: the download's size. -->
    <string name="update_install_download">Download and install, <xliff:g id="size" example="19.3 MB">%1$s</xliff:g></string>
    <!-- A size in megabytes, in the install row. -->
    <string name="update_megabytes"><xliff:g id="megabytes" example="19.3">%1$.1f</xliff:g> MB</string>

    <!-- Why an install stopped, in the install row: the connection dropped. -->
    <string name="update_failure_network">The download stopped. Tap to try again</string>
    <!-- Why an install stopped: the file wasn't the one GitHub published. -->
    <string name="update_failure_checksum">The download didn\'t match GitHub\'s checksum. Tap to try again</string>
    <!-- Why an install stopped: GitHub had no checksum to check the file against. -->
    <string name="update_failure_no_checksum">GitHub gave no checksum for it, so it wasn\'t installed</string>
    <!-- Why an install stopped: the file is another app. -->
    <string name="update_failure_not_openstrap">The download isn\'t OpenStrap, so it wasn\'t installed</string>
    <!-- Why an install stopped: this copy came from somewhere else (a store, a build of its own) and Android won't replace it. -->
    <string name="update_failure_signature">This copy of OpenStrap is signed with another key. Install it from GitHub instead</string>
    <!-- Why an install stopped: the phone is full. -->
    <string name="update_failure_storage">There isn\'t enough space to install it</string>
    <!-- Why an install stopped: Android refused it for another reason. -->
    <string name="update_failure_android">Android couldn\'t install it. Tap to try again</string>

    <!-- The notification's title when a new version is out. -->
    <string name="update_available_title">OpenStrap <xliff:g id="version" example="2.2.0">%1$s</xliff:g> is out</string>
    <!-- The notification's text when the release notes have nothing short to show. -->
    <string name="update_available_text">See what\'s new and install it from the Updates page.</string>
    <!-- The notification's title after OpenStrap updated itself. -->
    <string name="update_installed_title">Updated to OpenStrap <xliff:g id="version" example="2.2.0">%1$s</xliff:g></string>
    <!-- The notification's text after OpenStrap updated itself. A tap opens the release notes. -->
    <string name="update_installed_text">Tap to see what\'s new.</string>
    <!-- The notification channel's name in Android's notification settings for OpenStrap. -->
    <string name="update_channel_name">App updates</string>
</resources>
