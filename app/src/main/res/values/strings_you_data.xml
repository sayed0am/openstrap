<?xml version="1.0" encoding="utf-8"?>
<!--
  What happens to your data, from the You page: the Backup page, the Health Connect page, Deleted sleep, and what a
  failed backup, restore or Health Connect copy says (ui/device/BackupCopy.kt, BackupPage.kt, HealthConnectPage.kt,
  YouPage.kt, DeletedSleepPage.kt, ErrorCopy.kt, DeviceViewModel.kt). OpenStrap is the app's name, Health Connect is
  Android's health store and the Play Store is Google's app store. Keep them as they are.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The Automatic backup row while off. One line. -->
    <string name="you_backup_status_off">Off. A zip each day in a folder you choose</string>
    <!-- The Automatic backup row when the last one failed. The reason is one of the you_backup_failure sentences. -->
    <string name="you_backup_status_failed">Last backup failed. <xliff:g id="reason" example="There isn't enough space for it.">%1$s</xliff:g></string>
    <!-- The Automatic backup row before the first backup. -->
    <string name="you_backup_status_waiting">Each day while the phone charges. No backup yet</string>
    <!-- The Automatic backup row and the You page's Backup row. The time is "today at 03:12", "yesterday at 03:12" or "on Tue 20 Oct". -->
    <string name="you_backup_last">Last backup <xliff:g id="when" example="today at 03:12">%1$s</xliff:g></string>
    <!-- The You page's Backup row when the last one failed (the Backup page says why). -->
    <string name="you_backup_summary_failed">Last backup failed</string>
    <!-- The You page's Backup row when on, before the first backup. -->
    <string name="you_backup_summary_waiting">On. No backup yet</string>

    <!-- Why a backup failed, one sentence each. -->
    <string name="you_backup_failure_folder_gone">The folder is no longer available.</string>
    <string name="you_backup_failure_permission">OpenStrap can no longer reach the folder. Choose it again.</string>
    <!-- Why a backup or a saved copy failed: the phone is full. -->
    <string name="you_backup_failure_no_space">There isn\'t enough space for it.</string>
    <string name="you_backup_failure_cant_write">OpenStrap couldn\'t write to the folder.</string>
    <string name="you_backup_failure_other">It tries again tomorrow.</string>

    <!-- A message after a restore: how many records came back, and the settings. The number is already formatted, "1,234". -->
    <plurals name="you_backup_restored_records_settings">
        <item quantity="one">Restored <xliff:g id="count" example="1,234">%1$s</xliff:g> records and your settings.</item>
        <item quantity="other">Restored <xliff:g id="count" example="1,234">%1$s</xliff:g> records and your settings.</item>
    </plurals>
    <!-- A message after a restore: how many records came back. The number is already formatted, "1,234". -->
    <plurals name="you_backup_restored_records">
        <item quantity="one">Restored <xliff:g id="count" example="1,234">%1$s</xliff:g> records.</item>
        <item quantity="other">Restored <xliff:g id="count" example="1,234">%1$s</xliff:g> records.</item>
    </plurals>
    <string name="you_backup_restored_settings">Restored your settings. Your records were already here.</string>
    <string name="you_backup_restored_nothing">Nothing to restore. It\'s all already here.</string>
    <!-- Added after the restore message when some rows of the zip were damaged. The number is already formatted, "3". -->
    <plurals name="you_backup_restored_skipped">
        <item quantity="one"><xliff:g id="count" example="3">%1$s</xliff:g> rows couldn\'t be read.</item>
        <item quantity="other"><xliff:g id="count" example="3">%1$s</xliff:g> rows couldn\'t be read.</item>
    </plurals>
    <!-- The restore message, then the damaged rows. Both are whole sentences, "Restored 12 records. 3 rows couldn't be read." -->
    <string name="you_backup_restored_with_skipped"><xliff:g id="restored" example="Restored 12 records.">%1$s</xliff:g> <xliff:g id="skipped" example="3 rows couldn't be read.">%2$s</xliff:g></string>
    <!-- The Backup folder row before the folder's name is known. -->
    <string name="you_backup_folder_unknown">The folder you chose</string>
    <!-- What Back up now says when it's done. The name is the zip's file name. -->
    <string name="you_backup_outcome_done">Backed up as <xliff:g id="file" example="OpenStrap-backup-2026-10-17.zip">%1$s</xliff:g>.</string>
    <string name="you_backup_outcome_recording">A workout is recording. The backup runs after it ends.</string>
    <string name="you_backup_outcome_off">Automatic backup is off.</string>
    <!-- The reason is one of the you_backup_failure sentences. -->
    <string name="you_backup_outcome_failed">Couldn\'t back up. <xliff:g id="reason" example="There isn't enough space for it.">%1$s</xliff:g></string>
    <!-- A message once a copy is saved. -->
    <string name="you_backup_saved_copy">Saved a copy.</string>
    <!-- A message when Android won't let OpenStrap keep the backup folder. -->
    <string name="you_backup_folder_refused">OpenStrap can\'t keep writing to that folder. Choose another one.</string>

    <!-- The Backup page: its title and rows. -->
    <string name="you_backup_title">Backup</string>
    <string name="you_backup_automatic">Automatic backup</string>
    <string name="you_backup_folder">Backup folder</string>
    <string name="you_backup_now">Back up now</string>
    <!-- Under Back up now while it runs. -->
    <string name="you_backup_now_running">Backing up</string>
    <string name="you_backup_now_note">Saves today\'s zip in that folder</string>
    <string name="you_backup_restore_note">Any OpenStrap zip. Fills in what this phone is missing</string>
    <string name="you_backup_save_copy">Save a copy</string>
    <string name="you_backup_save_copy_note">A zip saved where you choose, never cleared</string>

    <!-- The Deleted sleep page's title. -->
    <string name="you_deleted_sleep_title">Deleted sleep</string>

    <!-- The auto sync row on the Health Connect page, stopped by itself because its permissions were taken back. -->
    <string name="you_hc_line_stopped_permissions">Stopped. Health Connect permissions were turned off</string>
    <!-- Stopped because Health Connect was removed, where the Play Store can install it again. -->
    <string name="you_hc_line_stopped_install">Stopped. Install Health Connect to turn it back on</string>
    <!-- Stopped because Health Connect isn't there and can't be installed. -->
    <string name="you_hc_line_stopped_unavailable">Stopped. Health Connect isn\'t available on this phone</string>
    <string name="you_hc_line_off">Off. Copies new data after each strap sync</string>
    <!-- On, before its first copy. -->
    <string name="you_hc_line_on">On. Copies new data after each strap sync</string>
    <!-- On, with the last copy. The time is "10:42", "yesterday 10:42", "Tuesday 10:42" or "Tue 12 Oct 10:42". -->
    <string name="you_hc_line_last">On. Last synced <xliff:g id="when" example="yesterday 10:42">%1$s</xliff:g></string>
    <!-- The You page's Health Connect row, shorter: stopped, and why. -->
    <string name="you_hc_summary_stopped_permissions">Stopped. Permissions were turned off</string>
    <string name="you_hc_summary_stopped_install">Stopped. Install Health Connect</string>
    <string name="you_hc_summary_stopped_unavailable">Stopped. Not available on this phone</string>

    <!-- The Health Connect page: its title, the auto sync switch and the rows under Any time. -->
    <string name="you_hc_title">Health Connect</string>
    <string name="you_hc_auto">Auto sync to Health Connect</string>
    <string name="you_hc_any_time">Any time</string>
    <string name="you_hc_copy_now">Copy now</string>
    <string name="you_hc_copy_now_note">The last 30 days, to Android Health Connect</string>
    <string name="you_hc_restore_note">Bring back what OpenStrap saved there</string>
    <string name="you_hc_open">Open Health Connect</string>
    <string name="you_hc_open_note">Permissions and data</string>
    <!-- Where Health Connect is a Play Store app that's missing or out of date: the button, and why. -->
    <string name="you_hc_install">Install Health Connect</string>
    <string name="you_hc_install_note">On this phone Health Connect is an app from the Play Store. Install it to copy your data there.</string>
    <!-- A short message when no app store opened. -->
    <string name="you_hc_store_failed">Couldn\'t open the Play Store.</string>

    <!-- Messages after a Health Connect restore or copy. -->
    <string name="you_hc_restored_none">Health Connect has no OpenStrap data to restore.</string>
    <!-- The number is already formatted, "1,234". -->
    <plurals name="you_hc_restored">
        <item quantity="one">Restored <xliff:g id="count" example="1,234">%1$s</xliff:g> records from Health Connect.</item>
        <item quantity="other">Restored <xliff:g id="count" example="1,234">%1$s</xliff:g> records from Health Connect.</item>
    </plurals>
    <plurals name="you_hc_wrote">
        <item quantity="one">Wrote <xliff:g id="count" example="1234">%1$d</xliff:g> records to Health Connect (last 30 days).</item>
        <item quantity="other">Wrote <xliff:g id="count" example="1234">%1$d</xliff:g> records to Health Connect (last 30 days).</item>
    </plurals>
    <!-- After the auto sync switch is turned on, which copies the last 30 days at once. -->
    <plurals name="you_hc_auto_wrote">
        <item quantity="one">Auto sync is on. Wrote <xliff:g id="count" example="1234">%1$d</xliff:g> records to Health Connect (last 30 days).</item>
        <item quantity="other">Auto sync is on. Wrote <xliff:g id="count" example="1234">%1$d</xliff:g> records to Health Connect (last 30 days).</item>
    </plurals>
    <!-- What failed, before the reason (you_error_hc). -->
    <string name="you_hc_restore_failed">Couldn\'t restore from Health Connect</string>
    <string name="you_hc_write_failed">Couldn\'t write to Health Connect</string>
    <string name="you_hc_auto_failed">Auto sync is on, but the first copy didn\'t work</string>

    <!-- A failed Save a copy. The reason is one of the sentences below. -->
    <string name="you_error_save_copy">Couldn\'t save the copy. <xliff:g id="reason" example="Try again, or choose another place.">%1$s</xliff:g></string>
    <string name="you_error_save_copy_permission">OpenStrap wasn\'t allowed to write there. Choose another place.</string>
    <string name="you_error_save_copy_gone">That place is no longer available. Choose another one.</string>
    <string name="you_error_save_copy_other">Try again, or choose another place.</string>
    <!-- A failed Restore of a zip. The reason is one of the sentences below. -->
    <string name="you_error_restore_copy">Couldn\'t restore the copy. <xliff:g id="reason" example="Try again.">%1$s</xliff:g></string>
    <string name="you_error_restore_not_copy">That file isn\'t an OpenStrap copy.</string>
    <string name="you_error_restore_cant_open">OpenStrap can\'t open that file. Choose it again.</string>
    <!-- The reason a failure gives when there's nothing better to say. -->
    <string name="you_error_try_again">Try again.</string>
    <!-- A failed Health Connect read or write: what failed (you_hc_restore_failed and the like), then why. -->
    <string name="you_error_hc"><xliff:g id="what" example="Couldn't write to Health Connect">%1$s</xliff:g>. <xliff:g id="reason" example="Try again.">%2$s</xliff:g></string>
    <string name="you_error_hc_permission">OpenStrap no longer has permission. Allow it in Health Connect.</string>
    <string name="you_error_hc_no_answer">Health Connect didn\'t answer. Try again.</string>
</resources>
