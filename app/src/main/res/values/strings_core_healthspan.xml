    <string name="core_healthspan_habit_vo2max">Fitness (VO2 max)</string>
    <!-- A habit Habit Age weighs, as a row title. -->
    <string name="core_healthspan_habit_steps">Steps</string>
    <!-- A habit Habit Age weighs, as a row title. How alike your sleep times are from day to day. -->
